    "class Probe {",
    "public static bool SubstringStart(){try { string s=\"abc\"; int start=-1; s.Substring(start); } catch(NeoArgumentError e) {return true;} catch(NeoError e) {return false;} return false;}",
    "public static bool SubstringEnd(){try { string s=\"abc\"; int start=2; int count=2; s.Substring(start,count); } catch(NeoArgumentError e) {return true;} catch(NeoError e) {return false;} return false;}",
    "public static bool FormatSpecifier(){try { int n=1; string format=\"X\"; n.ToString(format); } catch(NeoArgumentError e) {return true;} catch(NeoError e) {return false;} return false;}",
    "public static bool FormatDigits(){try { int n=1; string format=\"Fz\"; n.ToString(format); } catch(NeoArgumentError e) {return true;} catch(NeoError e) {return false;} return false;}",
    "public static bool FormatPrecision(){try { int n=1; string format=\"F29\"; n.ToString(format); } catch(NeoArgumentError e) {return true;} catch(NeoError e) {return false;} return false;}",
    "public static bool ParseInt(){try { string text=\"oops\"; int result=int.Parse(text); } catch(NeoArgumentError e) {return true;} catch(NeoError e) {return false;} return false;}",
    "public static bool ParseFloat(){try { string text=\"oops\"; float result=float.Parse(text); } catch(NeoArgumentError e) {return true;} catch(NeoError e) {return false;} return false;}",
    "public static bool ParseDecimal(){try { string text=\"oops\"; decimal result=decimal.Parse(text); } catch(NeoArgumentError e) {return true;} catch(NeoError e) {return false;} return false;}",
    "}"
