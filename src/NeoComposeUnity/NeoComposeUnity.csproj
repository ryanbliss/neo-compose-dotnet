<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>NeoCompose</RootNamespace>
    <!-- Override UnityManagedDir via env var or a local Directory.Build.props if your Unity install differs -->
    <UnityManagedDir Condition="'$(UnityManagedDir)' == ''">/Applications/Unity/Hub/Editor/6000.0.40f1/Unity.app/Contents/Managed/UnityEngine</UnityManagedDir>
    <!-- UPM packages Unity compiles into a project's Library (e.g.
         Unity.Localization) live in its ScriptAssemblies. Default to the
         HelloWorld sample's so this shim resolves them whether it is loaded
         standalone (the solution's own node) or referenced by a sibling shim —
         every reference then shares one project instance with no per-reference
         AdditionalProperties to fragment it. Override if your sample Library
         lives elsewhere. -->
    <NeoComposeUnityPackageAssembliesDir Condition="'$(NeoComposeUnityPackageAssembliesDir)' == ''">$(MSBuildThisFileDirectory)../../samples/HelloWorld/Library/ScriptAssemblies</NeoComposeUnityPackageAssembliesDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Editor-only files live in NeoComposeUnityEditor.csproj -->
    <Compile Remove="Editor\**" />
    <!-- Tests have their own Unity Test Framework asmdef and aren't compiled by this IDE shim -->
    <Compile Remove="Tests\**" />
    <!-- Exclude SDK-generated AssemblyInfo files under sibling csprojs'
         obj subfolders. `Directory.Build.props` pins each csproj's
         `BaseIntermediateOutputPath` to `obj/<MSBuildProjectName>/`, but
         the default `Compile` glob (`**/*.cs`) sweeps every obj subdir
         in the directory and would otherwise pull in duplicate
         `AssemblyInfo.cs` files. -->
    <Compile Remove="obj\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(UnityManagedDir)/UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.GridModule">
      <HintPath>$(UnityManagedDir)/UnityEngine.GridModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TilemapModule">
      <HintPath>$(UnityManagedDir)/UnityEngine.TilemapModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>$(UnityManagedDir)/UnityEngine.Physics2DModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(UnityManagedDir)/UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Localization" Condition="Exists('$(NeoComposeUnityPackageAssembliesDir)/Unity.Localization.dll')">
      <HintPath>$(NeoComposeUnityPackageAssembliesDir)/Unity.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.2D.Tilemap.Extras" Condition="Exists('$(NeoComposeUnityPackageAssembliesDir)/Unity.2D.Tilemap.Extras.dll')">
      <HintPath>$(NeoComposeUnityPackageAssembliesDir)/Unity.2D.Tilemap.Extras.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Newtonsoft.Json — the runtime export classes use it for the
         polymorphic IR deserialization (Pointer / Instruction / etc.).
         Unity supplies the actual DLL at runtime via the
         `com.unity.nuget.newtonsoft-json` UPM package; this NuGet
         reference is purely for the IDE shim's IntelliSense + build. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
