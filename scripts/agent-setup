#!/usr/bin/env bash
#
# SDK-side entry to rig provisioning (P53 §1.4, §5).
#
# The rig coordinator lives in neo-compose and provisioning always runs there,
# but an agent working in this repository should not have to know that. This
# shim delegates to the workspace launcher with this repository fixed as the
# source, so `scripts/agent-setup` here and `npm run agent:setup -- --source
# neo-compose-dotnet` at the workspace root are the same command.
#
#   scripts/agent-setup [--task <name>] [extra launcher args]
#
# The rig it reports owns BOTH worktrees: the branch lands on this
# repository's worktree and the neo-compose companion stays detached at main.

set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# The workspace root is not "one level up": a rig worktree lives at
# <workspace>/.rigs/<rigId>/neo-compose-dotnet, so both checkouts have to find
# the launcher by walking up to the directory that actually carries it.
find_workspace_root() {
  local candidate="$1"
  while [[ "$candidate" != "/" ]]; do
    if [[ -f "$candidate/scripts/agent-launcher.mjs" && -f "$candidate/config/repositories.json" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
    candidate="$(dirname "$candidate")"
  done
  return 1
}

workspace_root="${NEO_COMPOSE_WORKSPACE_ROOT:-}"

if [[ -n "$workspace_root" && ! -f "$workspace_root/scripts/agent-launcher.mjs" ]]; then
  echo "NEO_COMPOSE_WORKSPACE_ROOT is set to $workspace_root, which carries no scripts/agent-launcher.mjs." >&2
  exit 2
fi

if [[ -z "$workspace_root" ]]; then
  if ! workspace_root="$(find_workspace_root "$repository_root")"; then
    echo "No Neo workspace was found above $repository_root (looked for scripts/agent-launcher.mjs)." >&2
    echo "Clone this repository as a child of the Neo workspace, or set NEO_COMPOSE_WORKSPACE_ROOT." >&2
    exit 2
  fi
fi

if ! command -v node >/dev/null 2>&1; then
  echo "node was not found on PATH; the workspace launcher needs it." >&2
  exit 2
fi

exec node "$workspace_root/scripts/agent-launcher.mjs" setup --source neo-compose-dotnet "$@"
