# Visual Studio cache directory
.vs/

# Autogenerated VS/MD/Rider solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln

# Hand-authored IDE shim csprojs — these drive VSCode / Rider IntelliSense
# over the sample sources when the monorepo is opened outside Unity. They
# share a folder with Unity-generated csprojs (which match `*.csproj` above
# and stay ignored) but use a `.IDE.csproj` suffix so the two never collide.
!*.IDE.csproj
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# TextMeshPro
/[Aa]ssets/TextMesh*Pro/
