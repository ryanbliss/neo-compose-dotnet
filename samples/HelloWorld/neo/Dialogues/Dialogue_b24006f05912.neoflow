@id("46c8d12a-f1d9-45a7-90cd-357f0d9cf863")
@settings(
  name: "Venusian: the oldest pattern",
  saveOptionChoices: true,
)
sealed class Dialogue_b24006f05912 : Dialogue {
  @primary
  Outpost Value_c846e232de1f = Reference<Outpost>(id: "ed141cc4-304c-40cd-8229-105f1ee9b99c");

  @id("4eede4c6-17c9-5de2-8365-e992e11b56df")
  bool NeoFunction_7371b54c887d52d7864f87cbbb25a454() {
    return root.Save.Quest.Stage == QuestStage.threePaths && !root.Save.Quest.EvidenceFaith && root.Save.Bits >= 150;
  }

  @id("d27b191a-3c34-5718-b3c2-fc5d523c18ff")
  void NeoFunction_a98c46eb12f256e5aa35ec5c1691b91e() {
    root.Save.Quest.EvidenceFaith = true;
  }

  @id("285db144-2551-55aa-bd47-a267376ea5c9")
  void NeoFunction_332216a0e35a5c07a447575e354cdbef() {
    root.Save.Bits -= 150;
  }

  @id("5263c101-f7fd-46fe-b4bf-4c628b0e3e67")
  override Trigger Trigger = new(
    group: Visits.High,
    order: 0,
    when: [
    @id("307c83bd-5da3-5bd0-a7db-6104b1779f20")
    NeoFunction_7371b54c887d52d7864f87cbbb25a454,
  ],
    limit: 1,
  ) => Node_18adf8580888;

  @id("022c323c-61ce-4d2a-b971-b1a27a82d9da")
  Text Node_18adf8580888 = new(
    name: "v1",
  ) {
    @primary
    Outpost Value_f4392483e2b9 = Reference<Outpost>(id: "ed141cc4-304c-40cd-8229-105f1ee9b99c");
  
    """
    Darling, you're back! And looking absolutely radioactive. Listen — the House archive found our OLDEST couture pattern. Pre-classical. Pre-EVERYTHING. It's yours for 150 bits, because you're you.
    """
  
    @id("79cf5eb4-7d70-449d-8e1c-d23b195ac610")
    Option Option_1813ea816f83 = new(
      name: "Buy",
    ) {
      """
      Sold. Show me.
      """
    
      return Node_e0ad876b703e;
    }
  
    @id("dd54e322-db50-43ad-b6ab-0bce89442edf")
    Option Option_76c09d78f73f = new(
      name: "Haggle",
    ) {
      """
      For a piece of cloth?
      """
    
      return Node_79fe0775bd56;
    }
  }

  @id("0b8c244d-08e8-42ed-b2f9-bb38dafa76fe")
  Text Node_79fe0775bd56 = new(
    name: "v1b",
  ) {
    @primary
    Outpost Value_e99ab1d70989 = Reference<Outpost>(id: "ed141cc4-304c-40cd-8229-105f1ee9b99c");
  
    """
    A piece of— it's a sixteen-by-sixteen GRID, darling, every square numbered, colors by code. Ancient couture is PIXEL ART and we simply called it embroidery. 150. Final.
    """
  
    return Node_e0ad876b703e;
  }

  @id("fd9b634f-d9fa-4e87-be3c-6586d08d5ce3")
  Actions Node_e0ad876b703e = new(
    name: "v2",
  ) {
    @primary
    Outpost Value_616f4cbe758c = Reference<Outpost>(id: "ed141cc4-304c-40cd-8229-105f1ee9b99c");
  
    @id("9f4f993d-c685-4620-9bc0-c9b57226887d")
    NeoFunction_332216a0e35a5c07a447575e354cdbef();
  
    return Node_dcab9768d516;
  }

  @id("f6007dba-b774-49a1-a210-f389129df8e1")
  Text Node_dcab9768d516 = new(
    name: "v3",
  ) {
    @primary
    Outpost Value_6c17729f0c4f = Reference<Outpost>(id: "ed141cc4-304c-40cd-8229-105f1ee9b99c");
  
    """
    There. Sixteen by sixteen, and when you fill the squares... it's a little blue circle. A world, darling. The FIRST world. Some seamstress copied the icon of everything and vanity preserved what faith couldn't parse.
    """
  
    return Node_652b29bc3f2a;
  }

  @id("87fdb30b-0261-4b5e-89ec-8cc357f6ba96")
  Actions Node_652b29bc3f2a = new(
    name: "v4",
  ) {
    @primary
    Outpost Value_a719ba636f11 = Reference<Outpost>(id: "ed141cc4-304c-40cd-8229-105f1ee9b99c");
  
    @id("199efa5f-5349-444f-b5a7-569560c694d1")
    NeoFunction_a98c46eb12f256e5aa35ec5c1691b91e();
  
    return Node_151b5226599b;
  }

  @id("36499742-7538-482b-97aa-a6f5df13f90c")
  Text Node_151b5226599b = new(
    name: "v5",
  ) {
    @primary
    Outpost Value_28998a46ed7e = Reference<Outpost>(id: "ed141cc4-304c-40cd-8229-105f1ee9b99c");
  
    """
    Wear it where the monks can see, won't you? They'll weep. It'll be DIVINE.
    """
  }
}
