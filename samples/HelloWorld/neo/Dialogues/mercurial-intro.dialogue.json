  "Hello": {
   "say": "Light graces you, brave traveler. We've been expecting you.",
   "options": [
    {
     "label": "Surprise",
     "text": "You've been <i>expecting </i>me?",
     "to": "Sun shineth"
    },
    {
     "label": "Doubt",
     "text": "I bet you say that to everyone",
     "to": "Sun offers light"
    }
   ]
  },
  "Asketh": {
   "say": "Light Shines its abundance on Mercurial. Ask that which hath evadeth you in Darker realms.",
   "options": [
    {
     "label": "Cosmic",
     "text": "There are reports of cosmic disturbances",
     "to": "Cosmos crieth"
    },
    {
     "label": "Accuse",
     "text": "I know you have been causing the solar flares <i>(Lie)</i>",
     "to": "Light to dark"
    }
   ]
  },
  "mx4": {
   "say": "Begin where vanity shineth — Venus. And where stone remembereth — Mars. The Light goeth with thee, seeker. Spend it well."
  },
  "mx2": {
   "say": "When Sun hath given all it may, it giveth all at once. Red Nova is the last gift, the bright goodbye. It was not yet Time — unless the Spender maketh it so.",
   "to": "mx1"
  },
  "Cosmos crieth": {
   "say": "Aye, Cosmos crieth out through the Light. It was not Time for Red Nova, yet Time disturbeth all until Nova come.",
   "options": [
    {
     "label": "Who",
     "text": "Who spendeth the Sun before its Time?",
     "to": "mx1"
    },
    {
     "label": "Prophecy",
     "text": "What is the Red Nova?",
     "to": "mx2"
    }
   ]
  },
  "Sun offers light": {
   "say": "The Sun offereth its Light freely, but it cannot reach those inclined to Darkness.",
   "options": [
    {
     "label": "Fair",
     "text": "Fair enough. Well, I am looking for some information.",
     "to": "Asketh"
    },
    {
     "label": "Rude",
     "text": "Aren't you blind? Sounds pretty dark to me...",
     "to": "Decrease rep"
    }
   ]
  },
  "Sun shineth": {
   "say": "Sun shineth for those that seeketh.",
   "options": [
    {
     "label": "Seeketh",
     "text": "Well, I indeed was sent here to seeketh knowledge.",
     "to": "Increase rep"
    },
    {
     "label": "Mock",
     "text": "Does the sun shineth for those that seeketh to be blind?",
     "to": "Decrease rep"
    }
   ]
  },
