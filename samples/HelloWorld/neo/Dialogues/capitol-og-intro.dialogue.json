    "Impossible to reach": {
      "say": "How are you so poor?! You managed to lose the game in a way that should never happen, congratulations!"
    },
    "Intro": {
      "say": "As the OGs of the system, you probably won't want to leave {{neo-var:42b42e00-9b9c-4456-8100-38a8f3cd03f1}} during your stay, but you're <i>mostly</i> welcome to leave whenever you want!",
      "to": "What brings you here?"
    },
    "Jerk": {
      "say": "Wow. You're a real jerk, you know that?",
      "to": "Blame the mercurials"
    },
    "Strange cult": {
      "say": "Strange? Hmm...the {{neo-var:8c6427b4-9e59-4f38-8670-2090f21c4117}}s are a strange bunch, constantly staring into the sun. Even with all the solar flares we've been having lately! Blind as a bat, yep.",
      "to": "UNLOCK MERCIAL"
    },
    "Guilt trip mercurial warning": {
      "say": "Well, hope you brought another hat then. The sun has been flaring up lately. Something to do with the {{neo-var:895da7f1-82ed-4eab-842d-f5dd4c25399a}}s.",
      "options": [
        {
          "label": "Thanks",
          "text": "Thanks for the warning",
