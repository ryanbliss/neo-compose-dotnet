    "Optional Mercurial lore_": {
      "say": "Strange bunch, those ones. They are a cult who moved to {{neo-var:23aec2a1-e952-4c13-86fb-e0cede15f33c}} — the planet closest to the sun — so they could stare at it all the time. Super blind, yep.",
      "to": "Thank you!"
    },
    "Welcome!": {
      "say": "Hello, traveler! Welcome to the best planet of the best solar system in the <b>ENTIRE</b> galaxy!",
      "to": "Intro"
    },
    "Blame the mercurials": {
      "say": "All I know is that there have been an increase in solar flares. Rumor has it the {{neo-var:d922e051-7714-43df-814f-92f977494e03}}s know more. Now get out of here.",
      "to": "UNLOCK MERCIAL"
    },
    "Thank you!": {
      "say": "Fabulous! Hey, I'd recommend staying away from the {{neo-var:49aba70d-30fc-4ae9-8b1c-c5fff5f14e4e}}s. Rumor has it they are causing an uptick in solar flares, but don't worry! That's what the hat is for!",
      "options": [
        {
          "label": "Thanks",
          "text": "Thanks for the warning",
          "to": "Enjoy your visit!"
        },
        {
          "label": "Who?",
          "text": "Who are the {{neo-var:3e1d30e6-941b-450a-896d-b0512a29a678}}s?",
          "to": "Optional Mercurial lore_"
        }
      ]
    },
    "Buy souvenir?": {
      "say": "I knew it! Before you continue, would you like to purchase this very special {{neo-var:1e6fc91e-ad08-446e-afff-812af0476e0d}}? It is truly the PINNACLE of human craftsmanship!",
      "options": [
        {
          "label": "Yes",
          "text": "Buy the hat <b>(</b>{{neo-var:89ea16d4-6d4a-4e55-a3ea-3d973a1ffd02}}<b> bits)</b>",
          "to": "If can afford"
        },
        {
          "label": "No",
          "text": "No thanks",
          "to": "Not fashionable"
        }
      ]
