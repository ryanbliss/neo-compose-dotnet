@id("955d7862-dbb4-42ab-9514-b8f281b8c81a")
@settings(
  name: "Capitol OG epilogue",
  saveOptionChoices: true
)
sealed class CapitolOGEpilogue : Dialogue {
  @primary
  Outpost outpost = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");

  @id("4513a2dd-246b-5afc-8d39-072a9d39b408")
  bool NeoFunction_4e6a42bf348255cfbcee1e842cf7e6dc() {
    return root.Save.Quest.Ending == WorldEnding.secondSun;
  }

  @id("3261c9b1-9953-5286-aadf-26ab6dd2948b")
  void NeoFunction_055f1ed0f90e5ee7ba11480c9b378e9e() {
    root.Save.Bits += 50;
  }

  @id("352d7428-a322-47d9-bcf4-699608e7fd5b")
  override Trigger Trigger = new(
    group: Visits.Medium,
    order: 0,
    when: [
    @id("e81df6e0-58b0-55e6-865c-4536f090d8de")
    NeoFunction_4e6a42bf348255cfbcee1e842cf7e6dc,
  ],
  ) => Back;

  @id("afee8b0f-c51f-42c0-8091-1d7286e2f7de")
  Text Back = new(
    name: "back",
  ) {
    @primary
    Outpost outpost = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    """
    You're back! And in one piece! So... is it true what the relays are saying? A SECOND sun?
    """
  
    @id("e19859df-e15f-413c-9003-443a00961d8c")
    Option True = new(
      name: "True",
    ) {
      """
      It's true. The question is who it rises for.
      """
    
      return Rises;
    }
  
    @id("0173a459-2668-4b55-ab73-525751226d38")
    Option Quiet = new(
      name: "Quiet",
    ) {
      """
      You'll know when the sky tells you.
      """
    
      return Quiet;
    }
  }

  @id("763de46a-1911-483c-84c1-19f55091521d")
  Text Rises = new(
    name: "rises",
  ) {
    @primary
    Outpost outpost = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    """
    Huh. Two suns. Twice the flares, twice the hats. ...I should start knitting.
    """
  
    return Reward;
  }

  @id("8495e4d8-8b07-44a7-acbd-ca3615afa737")
  Text Quiet = new(
    name: "quiet",
  ) {
    @primary
    Outpost outpost = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    """
    Ugh, you're as cryptic as a Mercurial now. Fine. First round of bits is on the Capitol anyway — for making it back.
    """
  
    return Reward;
  }

  @id("6a251132-2df3-4c68-980e-ce74f7e9605d")
  Actions Reward = new(
    name: "reward",
  ) {
    @primary
    Outpost outpost = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    @id("356bf10f-2709-44c6-b015-b7a58b4e828c")
    NeoFunction_055f1ed0f90e5ee7ba11480c9b378e9e();
  
    return End;
  }

  @id("395661f4-9ebe-4709-900c-0a2c4a3cda63")
  Text End = new(
    name: "end",
  ) {
    @primary
    Outpost outpost = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    """
    Welcome home, investigator. Whatever happens next... nice to have someone who's seen the whole sky.
    """
  }
}
