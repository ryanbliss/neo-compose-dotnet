@id("9a0fd022-08ea-4bc1-a13d-302308f76900")
@settings(
  name: "Capitol: the Old Console",
  saveOptionChoices: true
)
sealed class CapitolTheOldConsole : Dialogue {
  @primary
  Outpost CapitolOG = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");

  @id("a27fb754-2f4a-59b1-94e9-1a189446f334")
  void Action1() {
    root.Save.Inventory.Remove(CapitolOG);
  }

  @id("f6bd0417-4f00-5f98-b1f2-3bb56d173938")
  bool Condition1() {
    return root.Save.Quest.Stage == QuestStage.vaultOpen && root.Save.Inventory.Contains(root.Assets.Items.First((i) => { return i.Id == "fec825b2-2449-4ae2-a4bd-b29f8cf73e3c"; }));
  }

  @id("add23745-9e97-5fce-90d1-4707dee6e5bf")
  void Action2() {
    CapitolOG.ShowRelic();
  }

  @id("5525313e-a37c-56b2-838c-5145e4b5383b")
  void Action3() {
    root.Save.Quest.Stage = QuestStage.endgame;
  }

  @id("5ef0d5a1-5d62-4533-82e8-91775954c831")
  override Trigger Trigger = new(
    group: Visits.High,
    order: 1,
    when: [
    @id("d8922469-b568-5854-a4f2-470b1c98c8a9")
    Condition1,
  ],
    limit: 1,
  ) => O1;

  @id("48742087-af52-4be7-b5d1-e11102d134dc")
  Text O3 = new(
    name: "o3",
  ) {
    @primary
    Outpost capitolOG = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    """
    The Patriarch closes his eyes: 'The counting ended, and we remained.' The Forewoman checks her sums twice. The Regent just smiles, like a man whose deletion is finally relevant. The world overflowed, traveler. The resets are failing. That's why you remember every run — and why, this time, everything gets to MATTER.
    """
  
    @id("7e1656d4-43ee-4753-b9d8-677e510c5695")
    Option Ready = new(
      name: "Ready",
    ) {
      """
      Then let's decide what happens next.
      """
    
      return O4;
    }
  }

  @id("faa12773-5350-4cc9-a95e-6055e95192b2")
  Text O2 = new(
    name: "o2",
  ) {
    @primary
    Outpost capitolOG = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    """
    'HELLO, WORLD!' That's all it says. The first artifact of existence, and it's a greeting — OUR greeting, the one the Capitol's said to every visitor since the beginning. The terminal below it is still running. One number, incrementing nowhere: RUN #2,147,483,648.
    """
  
    @id("10ce05eb-6a68-401d-af0e-6e2ba395fc1a")
    Option Overflow = new(
      name: "Overflow",
    ) {
      """
      That number... it's one past the largest count the world can hold.
      """
    
      return O3;
    }
  }

  @id("4c20c2cd-5f45-4a36-8306-adbf77e77ca3")
  Text O5 = new(
    name: "o5",
  ) {
    @primary
    Outpost capitolOG = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    """
    The terminal blinks, patient as scripture: AWAITING FINAL OUTPUT_ Behind you the Abyssal Lantern gutters out, its oil spent. Its work is done.
    """
  }

  @id("5e9f8668-2b30-409d-847a-415ea5048948")
  Actions O42 = new(
    name: "o4 (2)",
  ) {
    Outpost capitolOG = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    @primary
    Item abyssalLantern = Reference<Item>(id: "fec825b2-2449-4ae2-a4bd-b29f8cf73e3c");
  
    @id("282bb874-fa3b-4e07-a9b0-4ae2cd382d33")
    Action1();
  
    return O5;
  }

  @id("cba4d16d-bc15-424a-a534-a4fc0c50aadf")
  Actions O4 = new(
    name: "o4",
  ) {
    @primary
    Outpost capitolOG = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    @id("7417de5a-516c-4c42-85cc-0407364ee475")
    Action3();
  
    return O42;
  }

  @id("5df7e0e9-5d18-4bb7-957d-70c6f1c6c319")
  Text O1 = new(
    name: "o1",
  ) {
    @primary
    Outpost capitolOG = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    """
    The lantern holds. Down the shaft — your pitons would've saved an hour on those dead stairs — past pipes labeled in no alphabet, into a room that hums like the corn. A brass plaque. A terminal. And three people who got here first.
    """
  
    @id("843ec6c4-19fb-4608-b649-c691e8353c97")
    Option Plaque = new(
      name: "Plaque",
    ) {
      """
      Read the plaque.
      """
    
      return ShowRelic;
    }
  }

  @id("8726230d-5d4a-4002-9596-05038b7c0fc4")
  Actions ShowRelic = new(
    name: "show relic",
  ) {
    @primary
    Outpost capitolOG = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    @id("c6446a36-18f6-46ef-8f22-39766fac12a0")
    Action2();
  
    return O2;
  }
}
