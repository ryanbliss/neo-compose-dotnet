  bool NeoFunction_29731a3a7d9a5f979c1b6ba1854d4c0c() {
    return (root.Save.Quest.Stage == QuestStage.threePaths || root.Save.Quest.Stage == QuestStage.followTheWakes) && !root.Save.Quest.EvidenceFaith && Value_f1d72074e696.Save.Reputation >= 0;
  }

  @id("6cdfbf49-82f4-5a24-8854-c82040d54880")
  void NeoFunction_4cf98b5a73aa5087af846b6c04e70d38() {
    if (root.Save.Quest.Stage == QuestStage.followTheWakes) { root.Save.Quest.Stage = QuestStage.threePaths; }
  }

  @id("ce7bcbae-4538-5aa9-ab21-c27e8bd4b783")
