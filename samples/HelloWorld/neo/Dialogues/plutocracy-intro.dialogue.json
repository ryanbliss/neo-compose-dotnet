  "nodes": {
    "pl2": {
      "say": "The Gyre builds it, yes — but it will orbit US. A sun of Pluto's own. And when it lights, no astronomer alive will dare write 'dwarf' next to our name again.",
      "to": "pl3"
    },
    "ple2": {
      "say": "Then run fast, little herald. Light takes five hours to reach Earth from here — your warning will be racing it the whole way.",
      "to": "pla2"
    },
    "pl1": {
      "say": "Ah. The famous investigator, here at the edge of everything. Do you know what they took from us, before you were even born? A WORD. 'Planet.' One word, and the whole system stopped writing.",
      "options": [
        {
          "label": "Listen",
          "text": "Go on.",
          "to": "pl2"
        },
        {
          "label": "Cut",
          "text": "The Second Sun. It's yours, isn't it?",
          "to": "pl2"
        }
      ]
    },
    "pe2": {
      "say": "Behind you, the Plutocracy begins erasing its ledgers. The race to sunrise has started."
    },
    "pe1": {
      "say": "The sun sets on Earth. Somewhere past Neptune, a second dawn is loading."
    },
