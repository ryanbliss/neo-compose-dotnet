  @id("642967c4-4f97-4966-a62f-2c87231786ea")
  Text Node_f120027bf80e = new(
    name: "i1",
  ) {
    @primary
    Outpost Value_0fe01e171174 = Reference<Outpost>(id: "7a91f55f-a90e-4a80-80f4-43ad6386891a");
  
    """
    Howdy, stranger! Welcome to Iowan — best storm corn in four hundred moons, and don't let Venus tell you otherwise.
    """
  
    @id("5de8e168-75b1-446e-ba22-d9ee3da88fea")
    Option Option_fe0cc4bc2609 = new(
      name: "Corn?",
    ) {
      """
      You grow corn... on Jupiter?
      """
    
      return Node_2946a6951377;
    }
  
    @id("49789b78-ff3a-4a98-9846-3c89286180df")
    Option Option_1d06b4d7f95c = new(
      name: "Business",
    ) {
      """
      I'm tracking the freighters that ride the flare wakes.
      """
    
      return Node_fe0448bd2dc5;
    }
  }

  @id("3646ffb7-5ed3-48ef-ae45-6197412fdba6")
  Text Node_fe0448bd2dc5 = new(
    name: "i3",
  ) {
    @primary
    Outpost Value_98f77028030c = Reference<Outpost>(id: "7a91f55f-a90e-4a80-80f4-43ad6386891a");
  
    """
    Freighters, eh? Pour Lords on Ganymede run all the fuel out here — start with their ledgers. The Europapas folk have seen things under the ice, too. And the eggheads up Ursa Major chart every wake in the sky. Pick your moon, stranger.
    """
  
    return Node_db8e44fc1aea;
  }

