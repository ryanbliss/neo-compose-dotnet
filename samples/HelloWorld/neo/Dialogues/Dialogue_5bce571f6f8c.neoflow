  @id("45c15aa4-d60e-405e-a84d-ff6708725dbe")
  Text Node_0fdf1bf0c089 = new(
    name: "i5",
  ) {
    @primary
    Outpost Value_f5c81d7eaaab = Reference<Outpost>(id: "7a91f55f-a90e-4a80-80f4-43ad6386891a");
  
    """
    Take an ear of storm corn for the road. It hums when a flare's coming. Don't ask us why — we just farm here.
    """
  }

