  ) {
    @primary
    Outpost Value_8d22042f5714 = Reference<Outpost>(id: "ed141cc4-304c-40cd-8229-105f1ee9b99c");
  
    """
    Welcome, gorgeous, to the Cloud Court of Venus. Mind the acid rain — it's couture, not weather.
    """
  
    @id("d8532b08-18c2-46eb-9fce-ca4127e68386")
    Option Option_7c4bf7adb3ea = new(
      name: "Flattered",
    ) {
      """
      Why thank you. I'm here about the solar flares.
      """
    
      return Node_cf96e16809e1;
    }
  
    @id("79449d2c-3aac-4ba3-8415-b0ee11f8a819")
    Option Option_69ba82cb705e = new(
      name: "Blunt",
    ) {
      """
      Skip the spa pitch. Who's burning up the sun?
      """
    
      return Node_5eb549ce8203;
    }
  }

  @id("287a8fff-d49f-4e87-b5e6-bbab9eb8ba03")
  Text Node_cf96e16809e1 = new(
    name: "v2",
  ) {
    @primary
    Outpost Value_8b315442f8b0 = Reference<Outpost>(id: "ed141cc4-304c-40cd-8229-105f1ee9b99c");
  
    """
    Flares! Dreadful for the complexion. You know, the tankers that skim our cloud-tops have been riding sunward lately. Gyre Collective hulls, if you ask me — not that anyone asks Venus anything but skincare.
    """
  
    return Node_ed094ed8a361;
  }

  @id("9dab4a22-37aa-47ff-a539-61a8bc74bdbf")
  Text Node_5eb549ce8203 = new(
    name: "v3",
  ) {
    @primary
    Outpost Value_b35cf0078254 = Reference<Outpost>(id: "ed141cc4-304c-40cd-8229-105f1ee9b99c");
  
    """
    Rude AND sunburnt, tragic. Fine: ask the farm boys around Jupiter. Every freighter in the system refuels out there — fuel is gossip you can weigh.
    """
  
    return Node_ed094ed8a361;
  }

