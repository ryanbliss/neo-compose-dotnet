  @id("bd0d3603-98c0-4397-bcaf-ff8acfa9ca49")
  Text Node_3362bc5e5931 = new(
    name: "v5",
  ) {
    @primary
    Outpost Value_5ea12220aed9 = Reference<Outpost>(id: "ed141cc4-304c-40cd-8229-105f1ee9b99c");
  
    """
    Take this parasol, darling — genuine cloudsilk. It repels flare-light AND judgment. Now go bother Jupiter; tell the Iowan outpost Venus misses their corn.
    """
  }

