  @id("3e2b564e-e3ab-47cc-8adb-6810d0b7c858")
  Text Node_9c014c659e2e = new(
    name: "h1",
  ) {
    @primary
    Outpost Value_2a80ca0c5220 = Reference<Outpost>(id: "bb2dca5c-ab35-4ca5-82ec-a236f0de0a6f");
  
    """
    You carry the humming grain. Sit by the south geyser — listen. Your corn and our hymn... they hum the SAME line.
    """
  
    @id("d1f952e6-e98b-4419-9f84-64b38ef3e0e5")
    Option Option_589ec2dd5b0c = new(
      name: "Offer",
    ) {
      """
      Offer the Storm Corn
      """
    
      return Node_4ca9960d6b91;
    }
  
    @id("27dd1f16-c9f5-4d90-a3e9-414887c3f054")
    Option Option_dea8be2cb7cf = new(
      name: "Why",
    ) {
      """
      Why would corn know your scripture?
      """
    
      return Node_626c65d0357a;
    }
  }

  @id("43d949e8-b108-45ab-a0b0-b9a11e7fa261")
  Text Node_33aa81a86368 = new(
    name: "h5",
  ) {
    @primary
    Outpost Value_7f05d6161e4d = Reference<Outpost>(id: "bb2dca5c-ab35-4ca5-82ec-a236f0de0a6f");
  
    """
    Write it down, traveler: the world keeps minutes of its own birth. Whatever opens with such a key... it was built to be opened.
    """
  }

  @id("d72d0c98-47b4-4c61-929e-cafe3b3e38e8")
  Text Node_a463a74da574 = new(
    name: "h2",
  ) {
    @primary
    Outpost Value_cb4caaf4a01f = Reference<Outpost>(id: "bb2dca5c-ab35-4ca5-82ec-a236f0de0a6f");
  
    """
    We transcribed the south hymn against your grain's hum. Line lengths. Repeated headers. Timestamps, traveler. Our holiest hymn is a record of the world starting up. Generations chanted a boot log phonetically and called the warmth it gave them faith.
    """
  
    @id("c2e2c822-35b7-4317-b296-2cbc6b5f993f")
    Option Option_b73402cd2153 = new(
      name: "Gentle",
    ) {
      """
      It still gave warmth. That part was real.
      """
    
      return Node_09ce76006ee4;
    }
  
    @id("fcc9d4c5-714f-472a-85b8-0bc6467e91c1")
    Option Option_b923d0f493c6 = new(
      name: "Hollow",
    ) {
      """
      So your faith is a transcription error.
      """
    
      return Node_ed8dde640eeb;
    }
  }

  @id("bab0263f-7612-4b5f-82df-8d2878ffa9fe")
  Text Node_16fcc5103bfa = new(
    name: "h1x",
  ) {
    @primary
    Outpost Value_d25f86ed7f1b = Reference<Outpost>(id: "bb2dca5c-ab35-4ca5-82ec-a236f0de0a6f");
  
    """
    Then let the grain answer for itself, traveler.
    """
  
    @id("281adb46-b69e-434f-9106-1aa805d88ed7")
    Option Option_722b9e52c1ea = new(
      name: "Offer",
    ) {
      """
      Hand over the Storm Corn
      """
    
      return Node_4ca9960d6b91;
    }
  }

