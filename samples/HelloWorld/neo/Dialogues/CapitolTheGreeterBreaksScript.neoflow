@id("9aa5899e-e0ed-4b94-8994-8fcc92b421e0")
@settings(
  name: "Capitol: the greeter breaks script",
  saveOptionChoices: true
)
sealed class CapitolTheGreeterBreaksScript : Dialogue {
  @primary
  Outpost CapitolOG = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");

  @id("0db822dd-ee64-5fdc-8640-751285580560")
  void Action1() {
    root.Save.Quest.Stage = QuestStage.vaultOpen;
  }

  @id("e6df6ac6-7018-5e96-9c25-23eebb9ac664")
  void Action2() {
    CapitolOG.Save.Reputation += 1;
  }

  @id("ba2d5d68-65c9-54d1-acc7-b09232f09be9")
  bool Condition1() {
    return root.Save.Quest.Stage == QuestStage.threePaths && ((root.Save.Quest.EvidenceArchive && root.Save.Quest.EvidenceLedger) || (root.Save.Quest.EvidenceArchive && root.Save.Quest.EvidenceFaith) || (root.Save.Quest.EvidenceLedger && root.Save.Quest.EvidenceFaith));
  }

  @id("d5d01ff8-9968-43bd-ad9a-a2930b215efb")
  override Trigger Trigger = new(
    group: Visits.High,
    order: 5,
    when: [
    @id("0da625ab-4500-555b-bf3c-5dec9630748b")
    Condition1,
  ],
    limit: 1,
  ) => G1;

  @id("12bcbbd1-846f-43eb-892a-730ca77e4034")
  Text G1 = new(
    name: "g1",
  ) {
    @primary
    Outpost capitolOG = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    """
    Hello, traveler! Welcome to the best planet of the— ...no. No, you've heard that line. You've heard it EVERY time, haven't you. And you keep coming back with truths in your pockets.
    """
  
    @id("ddbd609f-003d-4d18-a3bd-707d3933b3b3")
    Option Show = new(
      name: "Show",
    ) {
      """
      I know what this world is. I have proof.
      """
    
      return G2;
    }
  
    @id("68def236-80e5-4cb6-94c6-5354981aefcb")
    Option Kind = new(
      name: "Kind",
    ) {
      """
      Take your time. Say it however you need to.
      """
    
      return G1b;
    }
  }

  @id("4ca0d81d-7d8f-4d05-b94c-0cab0fbb7756")
  Actions G1b = new(
    name: "g1b",
  ) {
    @primary
    Outpost capitolOG = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    @id("b6c76ad2-33d6-48f2-be4d-95332a8a6ed6")
    Action2();
  
    return G2;
  }

  @id("b3e5e6e6-4a8c-4cae-ba02-2d01253a459e")
  Text G2 = new(
    name: "g2",
  ) {
    @primary
    Outpost capitolOG = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    """
    Under the Capitol there's a door I'm not supposed to remember between... between VISITS. The Old Console. Where the world said its first words. Your proof is the key — I can feel the door listening to it.
    """
  
    @id("f368c980-41bd-47d4-b448-c9f38acac1ff")
    Option Open = new(
      name: "Open",
    ) {
      """
      Open it.
      """
    
      return G3;
    }
  }

  @id("37d67214-ba1f-4151-b445-6d5851014b09")
  Actions G3 = new(
    name: "g3",
  ) {
    @primary
    Outpost capitolOG = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    @id("7ac05c7d-4541-44ae-81ae-1efed5a5bc0e")
    Action1();
  
    return G4;
  }

  @id("e8b1dd24-2a4e-487a-8ac8-99eb8948d7b1")
  Text G4 = new(
    name: "g4",
  ) {
    @primary
    Outpost capitolOG = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    """
    The shaft is dark, traveler. DARK dark. Old-world dark. Bring a light that works where light was never installed... the ice-fishers of Europa carry such things. And traveler — thank you for not finishing my line for me.
    """
  }
}
