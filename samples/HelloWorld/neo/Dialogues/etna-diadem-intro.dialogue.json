    "d4": {
      "say": "Cryo salve, for burns of both kinds. Where you are going, the cold can scald worse than any flare."
    },
    "d2": {
      "say": "The deep current turns toward Neptune. The cold ones gather what the bright one sheds. We do not judge them — winter teaches its own prayers. But we remember everything.",
      "to": "d3"
    },
    "d1": {
      "say": "Welcome, traveler. Sit. The geysers are singing tonight.",
      "options": [
        {
          "label": "Listen",
          "text": "...What do they sing?",
          "to": "d2"
        },
        {
          "label": "Hurry",
          "text": "No time to sit. The sun is dying.",
          "to": "d2h"
        }
      ]
    },
    "d2h": {
      "say": "The sun is not dying. It is being SPENT. There is a difference, and the difference is a choice. ...Sit anyway. The geysers insist.",
