  @id("5df7e0e9-5d18-4bb7-957d-70c6f1c6c319")
  Text Node_07693829fb02 = new(
    name: "o1",
  ) {
    @primary
    Outpost Value_d2e66d2bbd99 = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    """
    The lantern holds. Down the shaft — your pitons would've saved an hour on those dead stairs — past pipes labeled in no alphabet, into a room that hums like the corn. A brass plaque. A terminal. And three people who got here first.
    """
  
    @id("843ec6c4-19fb-4608-b649-c691e8353c97")
    Option Option_cef22a286eb7 = new(
      name: "Plaque",
    ) {
      """
      Read the plaque.
      """
    
      return Node_1a65531ff752;
    }
  }

  @id("8726230d-5d4a-4002-9596-05038b7c0fc4")
  Actions Node_1a65531ff752 = new(
    name: "show relic",
  ) {
    @primary
    Outpost Value_b7bea70f6f25 = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
