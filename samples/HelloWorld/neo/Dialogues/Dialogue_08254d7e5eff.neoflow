    Item Value_b0daee44e52a = Reference<Item>(id: "fec825b2-2449-4ae2-a4bd-b29f8cf73e3c");
  
    @id("282bb874-fa3b-4e07-a9b0-4ae2cd382d33")
    NeoFunction_5bb9bb7a464e5898bdad9da4d63df529();
  
    return Node_600d872e5a12;
  }

  @id("cba4d16d-bc15-424a-a534-a4fc0c50aadf")
