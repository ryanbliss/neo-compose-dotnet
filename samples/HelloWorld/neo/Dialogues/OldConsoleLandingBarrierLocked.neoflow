@id("2a49e84a-ab1f-4468-a9a3-f29796cbf086")
@settings(
  name: "Old Console Landing: barrier locked",
  description: "Player inspects the vault seal before reading the boot glyph.",
  saveOptionChoices: true
)
sealed class OldConsoleLandingBarrierLocked : Dialogue {
  @primary
  BlockedPath BlockedPath = Reference<BlockedPath>(id: "432f5226-99d8-4d59-8cf0-4d86ca64462f");

  @id("6a355128-4ce5-407a-a0d2-6261615fc12d")
  override Trigger Trigger = new() => Start;

  @id("0441c3fb-1ce8-4b11-b2da-858042cdb93a")
  Text Start = new(
    name: "start",
  ) {
    @primary
    BlockedPath blockedPath = Reference<BlockedPath>(id: "432f5226-99d8-4d59-8cf0-4d86ca64462f");
  
    """
    A wall of teal light hums across the corridor, bright enough to throw your shadow back into the landing bay. The console recites, flat as a form letter: "Quarantine seal active. Boot trace required."
    """
  
    return Hint;
  }

  @id("dbe177ff-2b93-4325-af6d-f79807d6347d")
  Text Hint = new(
    name: "hint",
  ) {
    @primary
    BlockedPath blockedPath = Reference<BlockedPath>(id: "432f5226-99d8-4d59-8cf0-4d86ca64462f");
  
    """
    "The old boot glyph still glows in the chamber south of the landing bay. Walk it, and this seal will know your name."
    """
  }
}
