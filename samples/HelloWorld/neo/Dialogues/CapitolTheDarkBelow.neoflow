@id("7c3a3b7b-e644-4468-b46b-4a8335de80ac")
@settings(
  name: "Capitol: the dark below",
  saveOptionChoices: true
)
sealed class CapitolTheDarkBelow : Dialogue {
  @primary
  Outpost outpost = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");

  @id("78eae1a1-7292-5679-b097-9848073fc471")
  bool NeoFunction_0d5956f762c25c30b102fc81975a36ac() {
    return root.Save.Quest.Stage == QuestStage.vaultOpen && !root.Save.Inventory.Contains(root.Assets.Items.First((i) => { return i.Id == "fec825b2-2449-4ae2-a4bd-b29f8cf73e3c"; }));
  }

  @id("3676d9e6-ce3b-40ed-9a72-2a224a77014b")
  override Trigger Trigger = new(
    group: Visits.Low,
    order: 1,
    when: [
    @id("659bde4f-8eee-5b40-89a0-794f329da92b")
    NeoFunction_0d5956f762c25c30b102fc81975a36ac,
  ],
  ) => D1;

  @id("1f16db6a-d375-43b8-8ef1-046e3ad138b7")
  Text D1 = new(
    name: "d1",
  ) {
    @primary
    Outpost outpost = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    """
    The door's open, but ten steps down the dark just... eats the torch. It's not the absence of light down there, it's the absence of the IDEA of light. The Europapas fishers carry lanterns that work under ice. Under anything.
    """
  }
}
