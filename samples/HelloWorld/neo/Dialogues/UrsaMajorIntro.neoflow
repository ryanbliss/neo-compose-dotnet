@id("ec6050b7-a01a-42c0-855b-e60d8e55e1ac")
@settings(
  name: "Ursa Major intro",
  description: "The Red Nova Conspiracy — authored via @neocompose/cli.",
  saveOptionChoices: true
)
sealed class UrsaMajorIntro : Dialogue {
  @primary
  Outpost Outpost = Reference<Outpost>(id: "b81df7d3-be41-4685-9111-3cdc1821e693");

  @id("08700746-d38b-5735-8421-6e825e1d6668")
  void Action1() {
    Outpost.Save.Unlocked = true;
  }

  @id("46674347-a533-48a8-9a4c-096a30c25e1a")
  override Trigger Trigger = new(
    group: Introductions.Urgent,
    order: 0,
    limit: 1,
  ) => U1;

  @id("2477047f-ac50-4df1-b2c4-0d1be0b33b36")
  Text U1 = new(
    name: "u1",
  ) {
    @primary
    Outpost outpost = Reference<Outpost>(id: "b81df7d3-be41-4685-9111-3cdc1821e693");
  
    """
    Keep your voice down — the interferometer is listening. You're here about the sun. Everyone is, lately.
    """
  
    @id("14c6dadd-3fd4-43e4-bcd5-f8eec3d0e8df")
    Option Data = new(
      name: "Data",
    ) {
      """
      Show me the numbers.
      """
    
      return U2;
    }
  
    @id("9ac2305f-83d3-4645-b3b5-c3b86765fecb")
    Option Hunch = new(
      name: "Hunch",
    ) {
      """
      Just tell me your gut.
      """
    
      return U2g;
    }
  }

  @id("33142484-5c93-4073-9a83-4735e3b7af3b")
  Text U2g = new(
    name: "u2g",
  ) {
    @primary
    Outpost outpost = Reference<Outpost>(id: "b81df7d3-be41-4685-9111-3cdc1821e693");
  
    """
    Gut? We're scientists, we don't... oh, fine. My gut says the sun is losing weight, and it is NOT on a diet.
    """
  
    return U2;
  }

  @id("ad78a0fc-2533-40de-80ad-67948083142a")
  Text U2 = new(
    name: "u2",
  ) {
    @primary
    Outpost outpost = Reference<Outpost>(id: "b81df7d3-be41-4685-9111-3cdc1821e693");
  
    """
    Solar mass is down three tenths of a percent in a single year. That does not happen. Something is siphoning the corona — and every tanker wake we track curves past Saturn into the deep system.
    """
  
    return U3;
  }

  @id("7ca5e198-5832-4385-9976-386798b32004")
  Actions U3 = new(
    name: "u3",
  ) {
    @primary
    Outpost outpost_2 = Reference<Outpost>(id: "bb2dca5c-ab35-4ca5-82ec-a236f0de0a6f");
  
    Outpost outpost = Reference<Outpost>(id: "b81df7d3-be41-4685-9111-3cdc1821e693");
  
    @id("68eb6912-4f33-49d0-948e-3ddcb1702764")
    Action1();
  
    return U4;
  }

  @id("2d68a48e-4d26-49e1-86cd-f05ec580ec6b")
  Text U4 = new(
    name: "u4",
  ) {
    @primary
    Outpost outpost = Reference<Outpost>(id: "b81df7d3-be41-4685-9111-3cdc1821e693");
  
    """
    The Etna Diadem monks on Enceladus watch the deep current — monks notice what telescopes can't. Go gently. And if the sun flickers... call it in.
    """
  }
}
