    "i1": {
      "say": "Howdy, stranger! Welcome to Iowan — best storm corn in four hundred moons, and don't let Venus tell you otherwise.",
      "options": [
        {
          "label": "Corn?",
          "text": "You grow corn... on Jupiter?",
          "to": "i2"
        },
        {
          "label": "Business",
          "text": "I'm tracking the freighters that ride the flare wakes.",
          "to": "i3"
        }
      ]
    },
    "i3": {
      "say": "Freighters, eh? Pour Lords on Ganymede run all the fuel out here — start with their ledgers. The Europapas folk have seen things under the ice, too. And the eggheads up Ursa Major chart every wake in the sky. Pick your moon, stranger.",
      "to": "i4a"
    },
