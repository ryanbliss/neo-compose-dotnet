@id("cb0ac79c-f3b4-4c96-b968-8c4173c1f712")
@settings(
  name: "Old Console Landing: recovery cache",
  description: "Player opens the recovery cache in the vault and claims the bits.",
  saveOptionChoices: true
)
sealed class OldConsoleLandingRecoveryCache : Dialogue {
  @primary
  BlockedPath blockedPath = Reference<BlockedPath>(id: "432f5226-99d8-4d59-8cf0-4d86ca64462f");

  @id("d2f84eb0-2e86-4875-b0d3-1d70e2529f8e")
  override Trigger Trigger = new() => Start;

  @id("1e6004f9-4e7f-431e-a520-7fac2b691975")
  Text Start = new(
    name: "start",
  ) {
    @primary
    BlockedPath blockedPath = Reference<BlockedPath>(id: "432f5226-99d8-4d59-8cf0-4d86ca64462f");
  
    """
    The cache reads your boot trace one more time — out of politeness — then unlatches with a soft hydraulic sigh. Inside: a neat stack of bits, old but honest.
    """
  
    return Voice;
  }

  @id("172817c7-6b1b-4495-af82-a95a7be77551")
  Text Voice = new(
    name: "voice",
  ) {
    @primary
    BlockedPath blockedPath = Reference<BlockedPath>(id: "432f5226-99d8-4d59-8cf0-4d86ca64462f");
  
    """
    "Recovery payout, as promised," the console says. "Twenty-five bits, minted back when this deck still had traffic. Spend them somewhere that matters, runner."
    """
  }
}
