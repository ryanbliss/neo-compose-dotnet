  ) {
    @primary
    Outpost Value_df5b32041578 = Reference<Outpost>(id: "b81df7d3-be41-4685-9111-3cdc1821e693");
  
    @id("8a69573c-5a18-4ec2-b6ac-cd57f2c53da2")
    NeoFunction_df4b981a7bac557aa3bdaf9e911a14b7();
  
    @id("8055814e-6ac3-40a7-bce2-4894563ebdfd")
