  }

  @id("ccc02c47-74dc-4227-83e1-f3a027f30467")
  Text Node_ba7e42f4784d = new(
    name: "u5ask",
  ) {
    @primary
    Outpost Value_ca1ea843cc3b = Reference<Outpost>(id: "b81df7d3-be41-4685-9111-3cdc1821e693");
  
    """
    The Curator eyes the rigging bag on your shoulder. 'The high scope hasn't been climbed since the sky froze. Old knees,' he admits.
    """
  
    @id("b305fc58-9b44-44c9-a744-858a57d9057d")
    Option Option_3676da9a535f = new(
      name: "Rig",
      selectableWhen: [
      @id("2b7cd2cd-9cec-5dc2-ba85-a287e3f06873")
      NeoFunction_e35df6a3ab7857dd86139280473abaa4,
    ],
    ) {
      """
      Leave your Low-G Pitons rigged on the high scope
      """
    
      return Node_1574d776c960;
    }
  
    @id("3ee81a7e-09b8-4ca9-947f-d7e16952a346")
    Option Option_488d973fd0b2 = new(
      name: "Keep",
    ) {
      """
      You'll be needing them yourself
      """
    
      return Node_b3fe51892a8c;
    }
  }

