@settings(
  name: "Plutocracy intro",
  description: "The Red Nova Conspiracy — authored via @neocompose/cli.",
  saveOptionChoices: true,
)
sealed class Dialogue_3e88810d17be : Dialogue {
  @primary
  Outpost Value_6a1192e6b0af = Reference<Outpost>(id: "18154c7e-8f9a-4767-b44c-a25b0e1ca234");

  @id("ea568c94-3bc2-538f-8030-ff46ea5660f3")
