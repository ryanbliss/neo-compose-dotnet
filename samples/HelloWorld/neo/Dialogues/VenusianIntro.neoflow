@id("94500574-8e5e-4433-ab9e-a95b4d8f8179")
@settings(
  name: "Venusian intro",
  description: "The Red Nova Conspiracy — authored via @neocompose/cli.",
  saveOptionChoices: true
)
sealed class VenusianIntro : Dialogue {
  @primary
  Outpost outpost = Reference<Outpost>(id: "ed141cc4-304c-40cd-8229-105f1ee9b99c");

  @id("586db42e-af9c-5453-8895-ae859ff2629e")
  void Action1() {
    outpost.Save.Unlocked = true;
  }

  @id("fe7817ec-0dc1-5093-b12f-a61038e1894f")
  void Action2() {
    root.Save.Inventory.Add(outpost);
  }

  @id("3cc8a43f-1701-4988-86e6-199a06111f7d")
  override Trigger Trigger = new(
    group: Introductions.Urgent,
    order: 0,
    limit: 1,
  ) => V1;

  @id("96a83454-5260-4755-b7e0-b52ef0d4545a")
  Text V1 = new(
    name: "v1",
  ) {
    @primary
    Outpost outpost = Reference<Outpost>(id: "ed141cc4-304c-40cd-8229-105f1ee9b99c");
  
    """
    Welcome, gorgeous, to the Cloud Court of Venus. Mind the acid rain — it's couture, not weather.
    """
  
    @id("d8532b08-18c2-46eb-9fce-ca4127e68386")
    Option Flattered = new(
      name: "Flattered",
    ) {
      """
      Why thank you. I'm here about the solar flares.
      """
    
      return V2;
    }
  
    @id("79449d2c-3aac-4ba3-8415-b0ee11f8a819")
    Option Blunt = new(
      name: "Blunt",
    ) {
      """
      Skip the spa pitch. Who's burning up the sun?
      """
    
      return V3;
    }
  }

  @id("287a8fff-d49f-4e87-b5e6-bbab9eb8ba03")
  Text V2 = new(
    name: "v2",
  ) {
    @primary
    Outpost outpost = Reference<Outpost>(id: "ed141cc4-304c-40cd-8229-105f1ee9b99c");
  
    """
    Flares! Dreadful for the complexion. You know, the tankers that skim our cloud-tops have been riding sunward lately. Gyre Collective hulls, if you ask me — not that anyone asks Venus anything but skincare.
    """
  
    return V4;
  }

  @id("9dab4a22-37aa-47ff-a539-61a8bc74bdbf")
  Text V3 = new(
    name: "v3",
  ) {
    @primary
    Outpost outpost = Reference<Outpost>(id: "ed141cc4-304c-40cd-8229-105f1ee9b99c");
  
    """
    Rude AND sunburnt, tragic. Fine: ask the farm boys around Jupiter. Every freighter in the system refuels out there — fuel is gossip you can weigh.
    """
  
    return V4;
  }

  @id("6ee2c9c3-6eba-41cc-ac0f-8dcfadf25183")
  Actions V4 = new(
    name: "v4",
  ) {
    @primary
    Outpost outpost_2 = Reference<Outpost>(id: "7a91f55f-a90e-4a80-80f4-43ad6386891a");
  
    Outpost outpost = Reference<Outpost>(id: "ed141cc4-304c-40cd-8229-105f1ee9b99c");
  
    @id("c9369ac2-54cc-449a-af76-160933d4c375")
    Action1();
  
    return GrantCloudsilkParasol;
  }

  @id("bd0d3603-98c0-4397-bcaf-ff8acfa9ca49")
  Text V5 = new(
    name: "v5",
  ) {
    @primary
    Outpost outpost = Reference<Outpost>(id: "ed141cc4-304c-40cd-8229-105f1ee9b99c");
  
    """
    Take this parasol, darling — genuine cloudsilk. It repels flare-light AND judgment. Now go bother Jupiter; tell the Iowan outpost Venus misses their corn.
    """
  }

  @id("702fdeb2-3fc1-45f5-934d-0d5f2f570c1e")
  Actions GrantCloudsilkParasol = new(
    name: "grant Cloudsilk Parasol",
  ) {
    @primary
    Item item = Reference<Item>(id: "c263523c-352c-4273-885c-934bb35f5d16");
  
    Outpost outpost = Reference<Outpost>(id: "ed141cc4-304c-40cd-8229-105f1ee9b99c");
  
    @id("efbc6f53-5351-4788-bc16-524e756d4a40")
    Action2();
  
    return V5;
  }
}
