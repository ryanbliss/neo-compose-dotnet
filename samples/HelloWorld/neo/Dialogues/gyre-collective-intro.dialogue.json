        {
          "label": "Accuse",
          "text": "You're draining the sun. The inner worlds will burn, then freeze.",
          "to": "g2"
        },
        {
          "label": "Curious",
          "text": "What could possibly be worth a star?",
          "to": "g3"
        }
      ]
    },
    "g4c": {
      "say": "Spoken like someone who has never wintered on Triton. Take your outrage to the ones who pay us — and ask them what their new sun orbits.",
