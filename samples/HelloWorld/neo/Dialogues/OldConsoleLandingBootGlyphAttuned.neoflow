@id("12729fbc-56a7-4d8f-b04a-ac039604dfe9")
@settings(
  name: "Old Console Landing: boot glyph attuned",
  description: "Player reads the boot glyph in the south chamber; captures the boot trace that the vault seal answers to.",
  saveOptionChoices: true
)
sealed class OldConsoleLandingBootGlyphAttuned : Dialogue {
  @primary
  BlockedPath blockedPath = Reference<BlockedPath>(id: "432f5226-99d8-4d59-8cf0-4d86ca64462f");

  @id("6fed1e3d-ecf5-43a2-b66c-c7d59b348770")
  override Trigger Trigger = new() => Start;

  @id("1db648fc-0532-48f8-8ae1-c04ba82c29ba")
  Text Start = new(
    name: "start",
  ) {
    @primary
    BlockedPath blockedPath = Reference<BlockedPath>(id: "432f5226-99d8-4d59-8cf0-4d86ca64462f");
  
    """
    The dark tile wakes under your boots. Teal rings spin outward once, twice, then settle into a slow, steady pulse.
    """
  
    return Voice;
  }

  @id("b2aaf443-a842-4111-828d-8d9c5adecc7a")
  Text Voice = new(
    name: "voice",
  ) {
    @primary
    BlockedPath blockedPath = Reference<BlockedPath>(id: "432f5226-99d8-4d59-8cf0-4d86ca64462f");
  
    """
    A voice crackles up through the deck plating: "Boot trace verified. You're the first thing to walk this floor with a pulse in a very long time. The vault seal will answer to you now."
    """
  }
}
