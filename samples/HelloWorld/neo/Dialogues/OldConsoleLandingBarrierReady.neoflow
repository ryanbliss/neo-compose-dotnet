@id("d755935f-4c3a-4d43-8c40-4ba3f7d28063")
@settings(
  name: "Old Console Landing: barrier ready",
  description: "Player presents the boot trace at the seal (or plaque); the quarantine seal releases and the vault opens.",
  saveOptionChoices: true
)
sealed class OldConsoleLandingBarrierReady : Dialogue {
  @primary
  BlockedPath BlockedPath = Reference<BlockedPath>(id: "432f5226-99d8-4d59-8cf0-4d86ca64462f");

  @id("915d736e-80cd-5830-afb5-d3c1373aca14")
  void Action1() {
    BlockedPath.ClearPath();
  }

  @id("27bba0a1-d9f4-46bd-9cc1-424c5c19e85a")
  override Trigger Trigger = new() => Start;

  @id("91b6a4d9-678b-43c9-8166-c640db1dd29a")
  Text Start = new(
    name: "start",
  ) {
    @primary
    BlockedPath blockedPath = Reference<BlockedPath>(id: "432f5226-99d8-4d59-8cf0-4d86ca64462f");
  
    """
    The seal reads the boot trace humming in your boots. "Trace accepted," the console says, and for the first time it sounds almost relieved. "Stand clear."
    """
  
    return Clear;
  }

  @id("2ec78483-0d82-44d6-9523-044d0777ab53")
  Actions Clear = new(
    name: "clear",
  ) {
    @primary
    BlockedPath blockedPath = Reference<BlockedPath>(id: "432f5226-99d8-4d59-8cf0-4d86ca64462f");
  
    @id("553bd936-450b-494e-8119-d51bf53d6c7c")
    Action1();
  
    return Done;
  }

  @id("80d28883-d244-498b-a106-d98432157c82")
  Text Done = new(
    name: "done",
  ) {
    @primary
    BlockedPath blockedPath = Reference<BlockedPath>(id: "432f5226-99d8-4d59-8cf0-4d86ca64462f");
  
    """
    The field collapses into a line of falling sparks. Down the corridor, the vault answers with a heavy, satisfied click. Somewhere inside, a recovery cache is waiting to be claimed.
    """
  }
}
