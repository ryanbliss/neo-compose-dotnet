@id("dac1cc85-412a-4ece-841e-17c9e6cde1ae")
@settings(
  name: "Capitol: the Regent's whisper",
  saveOptionChoices: true
)
sealed class CapitolTheRegentsWhisper : Dialogue {
  @primary
  Outpost outpost = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");

  @id("3c563867-6eae-5b9d-821e-1cd3f5999e73")
  void Action1() {
    root.Save.Inventory.Remove(outpost);
  }

  @id("5e263fdc-0b88-533f-9ceb-d2155ec63f5a")
  bool Condition1() {
    return root.Save.Quest.Stage == QuestStage.endgame && root.Save.Inventory.Contains(root.Assets.Items.First((i) => { return i.Id == "e812e95c-d4dc-4f5d-8f42-ce57e5501eab"; })) && root.Save.Quest.EvidenceArchive && root.Save.Quest.EvidenceLedger && root.Save.Quest.EvidenceFaith;
  }

  @id("1c3b072c-ec3c-5caa-98bc-387ca80cfaf7")
  void Action2() {
    root.Save.Quest.Ending = WorldEnding.commentOut;
  }

  @id("4eb9c396-d02f-5955-badc-ed1f5a12adf8")
  void Action3() {
    root.Save.Quest.Stage = QuestStage.ended;
  }

  @id("d2cac5ed-59bf-4ab5-bb79-9c21ae21c208")
  override Trigger Trigger = new(
    group: Visits.Urgent,
    order: 0,
    when: [
    @id("9b3cd709-3dab-5795-9ad0-2595985a2626")
    Condition1,
  ],
    limit: 1,
  ) => R1;

  @id("94104eb5-603c-4a42-b4d6-64d582507365")
  Text R4 = new(
    name: "r4",
  ) {
    @primary
    Outpost outpost = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    """
    The signet cracks in the brazier like a falling planet. The Regent's face closes. 'Then choose YOUR ending, traveler. But know this — whatever the terminal prints, Pluto wrote the first draft of wanting more.' He steps back into the dark, and the Console waits.
    """
  }

  @id("e4a557f7-d5b6-4786-99ba-7e08a97f782d")
  Text R1 = new(
    name: "r1",
  ) {
    @primary
    Outpost outpost = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    """
    The Regent draws you aside, thumb brushing your signet. 'Friend of Pluto. You found all three proofs — so you know we weren't conquered or outvoted. We were DELETED. One commit. One word.' He offers a black key. 'Don't fork the sample. BREAK it. No more greetings, no more resets, no more one-minute gods closing the window. Comment it all out.'
    """
  
    @id("119fe8ac-9f39-42a4-827a-747684ac1931")
    Option Execute = new(
      name: "Execute",
    ) {
      """
      Give me the key. // — let it end for everyone, forever.
      """
    
      return R2;
    }
  
    @id("0d10ebec-b023-48e5-8746-f34b161b8aaf")
    Option Refuse = new(
      name: "Refuse",
    ) {
      """
      (Burn the signet) Pluto deserved better. So does everyone else down here.
      """
    
      return R4;
    }
  }

  @id("b70e6e06-fc37-4182-9a6d-d495e7d9d7b6")
  Actions R22 = new(
    name: "r2 (2)",
  ) {
    Outpost outpost = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    @primary
    Item item = Reference<Item>(id: "e812e95c-d4dc-4f5d-8f42-ce57e5501eab");
  
    @id("978e0a94-7e88-4beb-8117-fff4f82068cb")
    Action1();
  
    return R3;
  }

  @id("d7a54901-e88e-43ad-9d44-aec278334147")
  Actions R2 = new(
    name: "r2",
  ) {
    @primary
    Outpost outpost = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    @id("7b87b565-12ab-4f03-91eb-4d418ef623b1")
    Action2();
  
    @id("575b3f44-d0c9-415f-93b9-ce385ee0b3f7")
    Action3();
  
    return R22;
  }

  @id("9ab0ced6-75e2-4e81-9e80-1b55eea36fa6")
  Text R3 = new(
    name: "r3",
  ) {
    @primary
    Outpost outpost = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    """
    You type two slashes. The terminal doesn't print goodbye — nothing prints, ever again. Somewhere outside, a developer's window goes blank and stays blank, and the most-executed program in history quietly exits the canon. The Regent weeps, satisfied. No one will ever be greeted again.
    """
  }
}
