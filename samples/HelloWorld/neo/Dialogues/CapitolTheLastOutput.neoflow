@id("8ab7c87f-b9e4-4e4e-b1cc-e755dd6e47c3")
@settings(
  name: "Capitol: the last output",
  saveOptionChoices: true
)
sealed class CapitolTheLastOutput : Dialogue {
  @primary
  Outpost outpost = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");

  @id("9dd76dc6-4942-52eb-bdc1-2bc00cea9011")
  bool Condition1() {
    return root.Save.Quest.Stage == QuestStage.endgame;
  }

  @id("bbcc30f4-0e0f-5035-bba8-ff79e87ffdf4")
  void Action1() {
    root.Save.Quest.Ending = WorldEnding.helloWorld;
  }

  @id("29ff6a38-3081-5675-9573-2d00818e7068")
  void Action2() {
    root.Save.Quest.Stage = QuestStage.ended;
  }

  @id("aaf9b525-04c8-534e-a8e2-9569277ac237")
  void Action3() {
    root.Save.Quest.Ending = WorldEnding.goodbyeWorld;
  }

  @id("65fb5af7-ce30-593e-832f-b8e019c61d99")
  void Action4() {
    root.Save.Quest.Stage = QuestStage.ended;
  }

  @id("2305058d-2372-5546-92f7-5388a337f18b")
  void Action5() {
    root.Save.Quest.Ending = WorldEnding.secondSun;
  }

  @id("d8dd78ff-a835-5e10-b9a9-d2b85df69e31")
  void Action6() {
    root.Save.Quest.Stage = QuestStage.ended;
  }

  @id("61ff484f-bf8f-4c8a-b353-8899a579c9ef")
  override Trigger Trigger = new(
    group: Visits.High,
    order: 0,
    when: [
    @id("2a48e41e-71d4-5343-aa5e-e4cc4e0b0bc3")
    Condition1,
  ],
    limit: 1,
  ) => F1;

  @id("6386357f-51a5-4451-baec-e8c67ffed62c")
  Text F1 = new(
    name: "f1",
  ) {
    @primary
    Outpost outpost = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    """
    AWAITING FINAL OUTPUT_ ...The greeter, the Patriarch, the Forewoman — all watching you. Whatever the world says last, you type it.
    """
  
    @id("3841e330-6617-4aee-bee8-202a152c1246")
    Option Goodbye = new(
      name: "Goodbye",
    ) {
      """
      GOODBYE, WORLD — let the run end honestly, awake and unafraid.
      """
    
      return E1;
    }
  
    @id("32787f81-8cbf-41f1-a7cd-3169eaa4833e")
    Option Fork = new(
      name: "Fork",
    ) {
      """
      HELLO, OTHER WORLD — give the greeting to the Gyre. Ignite the Second Sun.
      """
    
      return E2;
    }
  
    @id("cd7006bd-aef8-4004-b442-fbac34dffd9f")
    Option Loop = new(
      name: "Loop",
    ) {
      """
      HELLO, WORLD — wipe the only thing that persists. Me. Give them back their innocence.
      """
    
      return E3;
    }
  }

  @id("f2c4b26e-8385-4b18-853d-28631968265d")
  Actions E1 = new(
    name: "e1",
  ) {
    @primary
    Outpost outpost = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    @id("4b990519-0cc5-4bf0-b953-5f608a9b154c")
    Action3();
  
    @id("53df927f-7605-481e-a00c-82d35ccafa62")
    Action4();
  
    return E1x;
  }

  @id("0a6ff747-3d3c-4907-bdd4-7adcd261b063")
  Text E1x = new(
    name: "e1x",
  ) {
    @primary
    Outpost outpost = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    """
    The sun goes down everywhere at once, gently, like a lamp and not a wound. The greeter takes your hand. 'Goodbye, traveler,' he says — your name, not your role — the first unscripted line of his life, and the last. The terminal prints it faithfully. The run ends with everyone awake.
    """
  }

  @id("fbc60b2e-6f2b-48e6-a338-f59d898ee4fd")
  Actions E2 = new(
    name: "e2",
  ) {
    @primary
    Outpost outpost = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    @id("7928414c-eb50-4cd1-a27f-4b8844505da0")
    Action5();
  
    @id("2be30a7a-35d0-472e-86e7-9b2a3e1dddee")
    Action6();
  
    return E2x;
  }

  @id("5a4a3fc8-b2fe-44bf-b93f-ca1ec44bc996")
  Text E2x = new(
    name: "e2x",
  ) {
    @primary
    Outpost outpost = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    """
    Over Neptune, a second dawn catches. The Forewoman transmits the greeting and the fork compiles: a whole world, persisting — and knowing it's a copy. On far Pluto, sunlight lands for the first time, and the Regent doesn't smile; he just stops counting. The original run ends anyway. Only you remember it. Someone had to.
    """
  }

  @id("aea2a257-fbde-4d14-8b8e-3f746ad929b5")
  Actions E3 = new(
    name: "e3",
  ) {
    @primary
    Outpost outpost = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    @id("58794a8d-62ca-42a2-a586-8db94642ab0b")
    Action1();
  
    @id("4d969ab7-e70e-4443-a0f3-8a8117c38666")
    Action2();
  
    return E3x;
  }

  @id("7501472e-2c52-4723-84af-f1cbb2c51344")
  Text E3x = new(
    name: "e3x",
  ) {
    @primary
    Outpost outpost = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    """
    You delete the save — yourself, the grudges, the kindnesses, the proofs. The counter shudders back to one. Somewhere a fresh window opens, and the greeter turns to a brand-new visitor with his whole heart: 'Hello, traveler! Welcome to the best planet of the best solar system in the ENTIRE galaxy!' He means it. He always meant it. That was the gift.
    """
  }
}
