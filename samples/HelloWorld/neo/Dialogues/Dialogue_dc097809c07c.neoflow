@id("f4364f10-d5da-4647-90d3-6e2ed28e7702")
@settings(
  name: "Capitol: cold boot",
  saveOptionChoices: true,
)
sealed class Dialogue_dc097809c07c : Dialogue {
  @primary
  Outpost Value_658dc27f7a45 = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");

  @id("48801854-31bc-5e9e-ba99-f5c2234496a0")
  bool NeoFunction_6172d966ca2457dfaf2b35974e33ffb4() {
    return root.Save.Quest.Reruns >= 1;
  }

  @id("36374c6a-22f8-4c58-a6e2-b2e33865befe")
  override Trigger Trigger = new(
    group: Visits.Urgent,
    order: 0,
    when: [
    @id("3dd4f849-e866-597b-87ef-3071ed8674e4")
    NeoFunction_6172d966ca2457dfaf2b35974e33ffb4,
  ],
    limit: 1,
  ) => Node_d10cc8710ac2;

  @id("f7c90bda-3412-4009-a61b-06dc00dae53d")
  Text Node_d10cc8710ac2 = new(
    name: "cb1",
  ) {
    @primary
    Outpost Value_1b99c0137d58 = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    """
    Hello, traveler! Welcome to the best planet of the best solar sys— ...wait. Wait wait wait. Your CARGO. We have never met, sojourner. So why do I remember selling you that hat?
    """
  
    @id("53428352-c7b6-4422-afc8-975a9bd8bc18")
    Option Option_b166198dff43 = new(
      name: "Explain",
    ) {
      """
      The sky tore. Everything went dark. Then I was here again.
      """
    
      return Node_b64b78a31ef8;
    }
  }

  @id("951a8f9d-dc9f-4db1-a042-c8dfb550b399")
  Text Node_b64b78a31ef8 = new(
    name: "cb2",
  ) {
    @primary
    Outpost Value_9c3cbadbd627 = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    """
    That was a RERUN. The world rebooted clean — fresh planets, fresh people, fresh ME. Nothing persists across runs. NOTHING. ...Except, apparently, your pockets. And whatever is wearing your face.
    """
  
    @id("5889ee9e-cb71-44e8-b739-fecc51f76e58")
    Option Option_0b9fa4434cd5 = new(
      name: "Press",
    ) {
      """
      What does that make me?
      """
    
      return Node_8e4369e29bfe;
    }
  }

  @id("8907a94a-21a5-4eff-a4e7-30dadea3fbb6")
  Text Node_8e4369e29bfe = new(
    name: "cb3",
  ) {
    @primary
    Outpost Value_858c04f65087 = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    """
    State, traveler. You're carried state. Somebody out there REALLY doesn't want to lose your progress. Finish what you started before the sky tears again — I don't want to meet you a third first time.
    """
  }
}
