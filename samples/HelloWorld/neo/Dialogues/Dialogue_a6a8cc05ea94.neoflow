    Outpost Value_7ebc9596076e = Reference<Outpost>(id: "bb2dca5c-ab35-4ca5-82ec-a236f0de0a6f");
  
    """
    Welcome, traveler. Sit. The geysers are singing tonight.
    """
  
    @id("fd7b37ed-4fe8-4659-bda7-e16abcb9bc04")
    Option Option_956a450ed139 = new(
      name: "Listen",
    ) {
      """
      ...What do they sing?
      """
    
