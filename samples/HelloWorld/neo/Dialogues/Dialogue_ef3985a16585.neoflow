@id("76546514-8523-4127-91f1-24cfd5a141a6")
@settings(
  name: "Pour Lords: money older than light",
  saveOptionChoices: true,
)
sealed class Dialogue_ef3985a16585 : Dialogue {
  @primary
  Outpost Value_4dfcdc2153a0 = Reference<Outpost>(id: "1c9e473a-3616-4c1c-82f7-461e080c9785");

  @id("ec99a707-f72e-5223-93bd-9947ab7fbbb2")
  void NeoFunction_4e44c6ffcc0e5094ad9dc3b402e153ee() {
    root.Save.Inventory.Remove(Value_4dfcdc2153a0);
  }

  @id("37fd3378-2891-5466-90a8-1dbc1758b1a1")
  bool NeoFunction_87e13f23cd395fe787d30f36055105b0() {
    return (root.Save.Quest.Stage == QuestStage.threePaths || root.Save.Quest.Stage == QuestStage.followTheWakes) && !root.Save.Quest.EvidenceLedger && Value_4dfcdc2153a0.Save.Reputation >= 1;
  }

  @id("3033ed4d-b7fd-5ba2-a418-5c5b095cbbae")
  void NeoFunction_22da634745dc5a59a08b4b57ba1c1f9f() {
    Value_4dfcdc2153a0.Save.Reputation += 1;
  }

  @id("3d167acf-6206-58c9-b369-8b6264b5b64d")
  void NeoFunction_27f788e01efc54a4990caa90ca416ae3() {
    if (root.Save.Quest.Stage == QuestStage.followTheWakes) { root.Save.Quest.Stage = QuestStage.threePaths; }
  }

  @id("b29ed7aa-af0f-595e-83ef-de152e65e287")
  void NeoFunction_196fe5626afb5acca81d4ec18da4856a() {
    root.Save.Quest.EvidenceLedger = true;
  }

  @id("52068637-6301-5fb5-b318-d61d6358f7c1")
  bool NeoFunction_1a366ec3d02f512a8a70adcb68d7c828() {
    return root.Save.Inventory.Contains(root.Assets.Items.First((i) => { return i.Id == "18b9a621-ea41-4ac7-8a46-9cc443f2b480"; }));
  }

  @id("ac9a8816-6fca-458d-a1ce-ec883d285cc8")
  override Trigger Trigger = new(
