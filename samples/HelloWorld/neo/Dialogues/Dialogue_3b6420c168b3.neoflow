  @id("55cd604a-448b-4eb4-bd13-aa8c0f8143c9")
  Text Node_633fe9fc9056 = new(
    name: "Intro",
  ) {
    @primary
    Outpost Value_df664829361f = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    """
    As the OGs of the system, you probably won't want to leave {Value_df664829361f.Planet} during your stay, but you're <i>mostly</i> welcome to leave whenever you want!
    """
  
    return Node_dc988a5545f5;
  }

  @id("050f1583-b0fa-44a4-964b-74d2c267aad8")
  Text Node_dc988a5545f5 = new(
    name: "What brings you here?",
  ) {
    @primary
    Outpost Value_e1b6568f6037 = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    """
    So, what brings you to {Value_e1b6568f6037.Planet}?
    """
  
    @id("73b12994-15b0-407a-84c1-64337cdcaf27")
    Option Option_6a9d675d9c26 = new(
      name: "Missions",
    ) {
      """
      Rumors of cosmic disturbances
      """
    
      return Node_33bf4dab108f;
    }
  
    @id("1d446373-0dc1-4540-9405-ac2de3c8faa9")
    Option Option_9de734a8f4e7 = new(
      name: "Tourist",
    ) {
      """
      To visit {Value_e1b6568f6037.Planet}, of course! <i>(lie)</i>
      """
    
      return Node_70e25d466c40;
    }
  }

  @id("37137d01-a012-423b-9760-ef9bc8b9f1c2")
  Text Node_33bf4dab108f = new(
    name: "Shock",
  ) {
    @primary
    Outpost Value_b2f4f631a91f = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    """
    What, here? You might as well turn around right now!
    """
  
    @id("b24ed163-2369-4bcb-9f1e-12712cb0c3be")
    Option Option_35d194a8b436 = new(
      name: "Question",
    ) {
      """
