      """
    
      return Node_99c88740bbdd;
    }
  }

  @id("d8f50e6c-86a2-4b77-8309-7304355ce6bc")
  Text Node_70e25d466c40 = new(
    name: "Buy souvenir?",
    saveChoice: false,
  ) {
    @primary
    Outpost Value_ff58a71b46da = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    Item Value_fa813210dae6 = Reference<Item>(id: "ca105d9d-2885-4f33-80d4-206d5e207173");
  
    """
    I knew it! Before you continue, would you like to purchase this very special {Value_fa813210dae6.Name}? It is truly the PINNACLE of human craftsmanship!
    """
  
    @id("e1fd78a9-c6e7-48a9-b9d8-26cdb8fd3608")
    Option Option_1dde5a937ea9 = new(
      name: "Yes",
    ) {
      """
