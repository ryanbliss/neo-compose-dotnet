  @id("87a0a8b0-2cdd-4c73-b0a7-1cef41005eb8")
  Text Node_38fe3410d06c = new(
    name: "Guilt trip mercurial warning",
  ) {
    @primary
    Outpost Value_ad64e69de668 = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    Outpost Value_c747c1029cab = Reference<Outpost>(id: "88cacaa9-25d2-4cfd-bd10-55db71139608");
  
    """
    Well, hope you brought another hat then. The sun has been flaring up lately. Something to do with the {Value_c747c1029cab.Name}s.
