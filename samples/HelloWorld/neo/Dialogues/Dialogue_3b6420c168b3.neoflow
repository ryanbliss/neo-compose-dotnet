  @id("d4a4adee-a368-44d7-9d5c-b8483a8ed53a")
  Text Node_54f2cbc12ae4 = new(
    name: "Thank you!",
  ) {
    @primary
    Outpost Value_47aa705d0b10 = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    Outpost Value_b9bfe2405ea6 = Reference<Outpost>(id: "88cacaa9-25d2-4cfd-bd10-55db71139608");
  
    """
    Fabulous! Hey, I'd recommend staying away from the {Value_b9bfe2405ea6.Name}s. Rumor has it they are causing an uptick in solar flares, but don't worry! That's what the hat is for!
    """
  
    @id("2019213b-8f57-41ec-8089-13c3023eee94")
    Option Option_1150b3ee3900 = new(
      name: "Thanks",
    ) {
      """
      Thanks for the warning
      """
    
