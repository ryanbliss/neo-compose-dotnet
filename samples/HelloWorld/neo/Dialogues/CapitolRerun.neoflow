@id("52f81a83-d091-4491-84c8-d61563202aff")
@settings(
  name: "Capitol: rerun",
  saveOptionChoices: true
)
sealed class CapitolRerun : Dialogue {
  @primary
  Outpost outpost = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");

  @id("e813f857-56f4-586a-a488-900901721de0")
  void NeoFunction_0d700a44d25a5fd79f2c02ac7af0d443() {
    outpost.Save.Reputation += 1;
  }

  @id("7e114d27-e3c5-5dd2-a567-25e6c7f6bc42")
  bool NeoFunction_b6d4a5268f64563180b6fb9c93668ea8() {
    return root.Save.Quest.FlareClock >= 6 && root.Save.Quest.Stage != QuestStage.ended;
  }

  @id("d2afda0e-48da-415a-ac15-1306fc53d7fe")
  override Trigger Trigger = new(
    group: Visits.Low,
    order: 0,
    when: [
    @id("d8d80ede-e605-5304-8695-b9f8f6eda251")
    NeoFunction_b6d4a5268f64563180b6fb9c93668ea8,
  ],
  ) => Z1;

  @id("93a671ab-b8a4-4d1c-a604-2f1cf1954c1b")
  Text Z1 = new(
    name: "z1",
  ) {
    @primary
    Outpost outpost = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    """
    Hello, traveler! Welcome to the best planet of the best solar system in the— in the— in the ENTIRE galaxy! ...I'm sorry. I said that already. Didn't I? I keep— the flares, you understand. I keep starting over mid-
    """
  
    @id("2f1c2f19-0962-4e2d-91bb-3c52ebda99fa")
    Option Steady = new(
      name: "Steady",
    ) {
      """
      You're all right. I've got you. Breathe.
      """
    
      return Z2;
    }
  }

  @id("62076b30-7fec-40cf-8d30-8d4e990b7bc4")
  Actions Z2 = new(
    name: "z2",
  ) {
    @primary
    Outpost outpost = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    @id("04b429f5-a576-4f75-947e-bf1275dcad6c")
    NeoFunction_0d700a44d25a5fd79f2c02ac7af0d443();
  
    return Z3;
  }

  @id("b0dfba02-86fa-4f05-8a3e-884c53c0c7f4")
  Text Z3 = new(
    name: "z3",
  ) {
    @primary
    Outpost outpost = Reference<Outpost>(id: "913fd757-d6ee-488e-866f-c7af41aa544b");
  
    """
    ...Thank you. You know what's strange? Of everyone who's ever visited — and traveler, it feels like THOUSANDS — you're the only one who ever seems to stay real all the way through.
    """
  }
}
