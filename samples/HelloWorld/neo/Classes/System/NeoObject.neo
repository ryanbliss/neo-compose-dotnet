@id("system_f671535d-0eb6-4139-9caf-5c5276febd31")
@system(kind: .WorldAuthoring, worldKind: .Object)
abstract class NeoObject : NeoObjectBase {
  /// The origin cell of this object's current placement. Detached objects have no cell.
  @id("system_c609fed3-53e4-5147-b493-e4aa23031d79")
  @system(kind: .WorldAuthoring)
  public virtual Vector2Int Cell => this.GetCell();

  @id("system_bb5d2cf1-a0dd-4eba-a62e-0e1bf0177071")
  @system(kind: .WorldAuthoring)
  public virtual List<NeoObjectBase> Children = [];

  @id("system_df1c2d06-eeec-5340-addc-740f3668c9e4")
  @system(kind: .WorldAuthoring)
  native private Vector2Int GetCell();

  /// Objects of type T at the cells around this placement, shifted by offset, in pattern order. A repeated footprint can appear more than once.
  @id("system_f5ca386c-990c-54a1-8473-2d49d2cd887d")
  @system(kind: .WorldAuthoring)
  native public virtual List<T> GetObjects<T extends NeoObject = NeoObject>(NeoCellPattern pattern, Vector2Int? offset = null);

  /// The first tile of type T found in pattern order around this placement, shifted by offset, or null. Each cell uses the grid layer precedence.
  @id("system_593e6208-e2ca-505e-9933-04b17102b6d2")
  @system(kind: .WorldAuthoring)
  native public virtual T? GetTile<T extends NeoTile = NeoTile>(NeoCellPattern pattern, Vector2Int? offset = null);

  /// The tiles of type T at the cells around this placement, shifted by offset, in pattern order. Each cell uses the grid layer precedence and empty cells are skipped.
  @id("system_5a41d36a-bcd9-4867-9e46-d743f6e09582")
  @system(kind: .WorldAuthoring)
  native public virtual List<T> GetTiles<T extends NeoTile = NeoTile>(NeoCellPattern pattern, Vector2Int? offset = null);

  /// The cells this object occupies, as offsets from its placement cell. An empty list occupies nothing: the object blocks no placement and answers no cell query, but a placed object still has a Cell.
  @id("system_5a9ca1f5-a21b-4d4e-8c55-00341af594b4")
  @system(kind: .WorldAuthoring)
  public virtual List<NeoPlacementTile> PlacementTiles = [];
}
