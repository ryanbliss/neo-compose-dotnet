@id("system_04ef83b0-3171-4299-9580-902708690750")
@system(kind: .WorldAuthoring, worldKind: .ObjectLayerLink)
abstract class NeoObjectLayerLink : NeoLayerGroupBase, IEnumerable<NeoObjectBase> {
  @id("system_7604a328-0fbc-5e13-afaf-772fe49d52bd")
  @system(kind: .WorldAuthoring)
  public virtual void Clear() {
    Objects.Clear();
  }

  @id("system_c23d33dd-0a6f-55d7-9618-764d0dc9b342")
  @system(kind: .WorldAuthoring)
  public virtual bool Contains(NeoObjectBase obj) => Objects.Contains(obj);

  @id("system_ebaddc47-73f4-5772-9f44-22e1bce73920")
  @system(kind: .WorldAuthoring)
  public virtual int Count => Objects.Count;

  @id("system_0595b60c-f1ad-51fd-a893-f215ffc08a25")
  @system(kind: .WorldAuthoring)
  public virtual IEnumerator<NeoObjectBase> GetEnumerator() => Objects.GetEnumerator();

  @id("system_9ca87cf0-f742-509a-8dbc-9bdeda85e9f9")
  @system(kind: .WorldAuthoring)
  public virtual int IndexOf(NeoObjectBase obj) => Objects.IndexOf(obj);

  @id("system_f8e217b1-da89-4819-9c8d-e9c9da2bdfb2")
  @settings(kind: .Unordered)
  @system(kind: .WorldAuthoring)
  protected virtual List<NeoObjectBase> Objects = [];

  @id("system_e856d561-6715-5e66-80cb-0e27fb2f98d5")
  @system(kind: .WorldAuthoring)
  public virtual bool Remove(NeoObjectBase obj) {
    int index = Objects.IndexOf(obj);
    if (index < 0) return false;
    Objects.RemoveAt(index);
    return true;
  }

  @id("system_9fb7f58b-8e13-5ea7-88db-8fa506ba93e6")
  @system(kind: .WorldAuthoring)
  public virtual void RemoveAt(int index) {
    Objects.RemoveAt(index);
  }

  /// Validates against the owning grid and writes to this link. Cells are grid-relative when attached and link-local when detached. Failure leaves the link and object unchanged.
  @id("system_fdeabfed-3e78-55ca-b793-3a5e3e5cdad7")
  @system(kind: .WorldAuthoring)
  native public virtual NeoPlacementResult TrySpawn(Vector2Int cell, NeoObjectBase obj);
}
