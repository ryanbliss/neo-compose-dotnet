@id("system_d7fa161b-b269-4bf1-9ec9-3aebec67e6e0")
@system(kind: .WorldAuthoring, worldKind: .Tile)
abstract class NeoTile {
  @id("system_f4be2707-74f5-4833-9784-e81bb2474330")
  @system(kind: .WorldAuthoring)
  public virtual Vector2Int Cell = new(0, 0);

  @id("system_3b02422f-1ef2-4a50-8386-155d5001082b")
  @storage(allowed: .Immutable)
  @distribution(kind: .Packed)
  @settings(format: .Plain)
  @system(kind: .WorldAuthoring)
  public virtual readonly string Name = "";

  @id("system_96cda8f5-3100-45b5-adcb-0552d21504dd")
  @storage(allowed: .Immutable)
  @system(kind: .WorldAuthoring)
  public virtual readonly NeoSmartTile? SmartTile = null;

  @id("system_cbd6db9a-f473-44b5-b913-7cdc06452f35")
  @storage(allowed: .Immutable)
  @system(kind: .WorldAuthoring)
  public virtual readonly SpriteInfo Sprite = SpriteInfo.Empty;

  /// Converts this placement to the target's concrete tile class, preserving its identity and Cell. Use TryConvert<T>() when the target class is known statically.
  @id("system_54ecc5a7-874d-54ed-92f4-38100a4b7465")
  @system(kind: .WorldAuthoring)
  native public virtual bool TryConvert(NeoTile target);
}
