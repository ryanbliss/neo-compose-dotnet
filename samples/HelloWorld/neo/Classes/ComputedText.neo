@id("2ab1bc07-da0b-47fc-b77b-54cc511575bb")
class ComputedText {
  @id("29659610-fc70-4b9c-833e-a6185f745c04")
  public virtual string baseText = "Hello";

  @id("acf7a92c-9ede-4a0d-a00c-c8c64e7a9b80")
  public virtual string fullText {
    get {
      Planet planet = root.Save.World;
      		string suffix = this.optionalSuffix ?? "";
      		return $"{this.baseText} {planet}{suffix}";
    }
  }

  @id("d56d641e-4f15-4da6-8c1f-114016c9166d")
  public virtual string? optionalSuffix;
}
