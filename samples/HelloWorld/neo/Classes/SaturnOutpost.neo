@id("96818dab-90e5-4ab9-8f69-cce66e39e370")
class SaturnOutpost : Outpost {
  @id("33e86f10-7989-4d82-9156-631a19e3bf06")
  override string FullDisplayText {
    get {
      return $"{this.Name}, {this.Moon}, {this.Planet}";
    }
  }

  @id("a804bead-3d5b-4c68-a733-94e85e1e79b6")
  virtual SaturnMoon Moon;

  @id("08cc78f5-3f90-43cc-89d7-9ec8d58e8dd0")
  override Planet Planet = .saturn;
}
