/// Plays another object's clip on this clip's timeline, looked up by name. The
/// lane is as long as the clip it names.
@id("system_8dc78ecf-15b8-4b8a-86f3-7691a5b487d0")
@storage(allowed: .Immutable)
@system(kind: .WorldAuthoring, worldKind: .AnimationChildTrack)
class NeoAnimationChildTrack(NeoDelegate<NeoObjectBase> selector, string clipKey) : NeoAnimationTrackBase(selector: selector) {
  @id("system_2c816624-0281-46d3-9ed5-d20bd43519f4")
  @locked
  @settings(localizable: false)
  @system(kind: .WorldAuthoring)
  public virtual string ClipKey = clipKey;
}
