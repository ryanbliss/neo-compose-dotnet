<Project Sdk="Microsoft.NET.Sdk">

  <!-- IDE-only schema project. Neo statically analyzes this project; authored
       code is never executed and is never shipped with the game. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>11</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="NeoCompose.Schema" HintPath=".neo/tooling/NeoCompose.Schema.dll" Private="false" />
    <Analyzer Include=".neo/tooling/NeoCompose.Schema.Tooling.dll" />
  </ItemGroup>

</Project>
