    "9f69a0f8-830a-42fa-ac11-e5ca3137ecac": null,
    "9f845505-9ef7-40c5-9d64-a92b0efe9660": "Eh, vale...",
    "9fac6d09-220e-4f31-b27d-466241a4589d": "Comprar el sombrero <b>(</b>{{neo-var:89ea16d4-6d4a-4e55-a3ea-3d973a1ffd02}}<b> bits)</b>",
