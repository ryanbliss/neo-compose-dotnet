    "8d9dd4e3-7185-40ea-a779-d13462983d47": null,
    "90811ced-66b6-4f46-bc60-d8f8bec3781a": "¡Vaya, qué alegría verte!",
    "908d908c-83f9-4b18-a458-21da21e398e8": "¡Fabuloso! Oye, te recomendaría mantenerte lejos de los {{neo-var:49aba70d-30fc-4ae9-8b1c-c5fff5f14e4e}}. Se rumorea que están causando un aumento de erupciones solares, ¡pero no te preocupes! ¡Para eso está el sombrero!",
    "90bd0085-b307-490d-9294-cf05e96fd30b": null,
