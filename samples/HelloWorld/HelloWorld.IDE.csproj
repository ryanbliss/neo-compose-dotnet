<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>HelloWorld</RootNamespace>
    <UnityScriptAssembliesDir Condition="'$(UnityScriptAssembliesDir)' == ''">Library/ScriptAssemblies</UnityScriptAssembliesDir>
    <!-- Hand-authored IDE shim. The actual sample compile is driven by Unity
         via the asmdefs under `Assets/`. This csproj exists so VSCode / Rider
         can resolve `using UnityEngine;` and `using NeoCompose.Runtime` when the
         monorepo is opened outside Unity. The `.IDE.csproj` suffix prevents
         collision with the `HelloWorld.csproj` that Unity generates from the
         `Assets/Scripts/HelloWorld.asmdef` whenever the sample is opened in
         Unity (Unity-generated csprojs are gitignored; this one is checked
         in). -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Limit the compile set to the asmdef's scripts. The default Sdk glob
         (`**/*.cs`) would also pick up files under `Assets/Tests/` (which
         belong to the test csproj) and any sibling `obj/<csproj>/`
         AssemblyInfo files. -->
    <Compile Remove="**/*.cs" />
    <Compile Include="Assets/Scripts/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- NeoComposeUnity.csproj self-defaults NeoComposeUnityPackageAssembliesDir
         to this sample's ScriptAssemblies, so no AdditionalProperties are
         needed (and passing them would fork it into a second build instance
         alongside the Convex shim's reference below). -->
    <ProjectReference Include="..\..\src\NeoComposeUnity\NeoComposeUnity.csproj" />
    <!-- The sample registers the Convex realtime provider (`using
         NeoCompose.Convex`). The package's compiled `NeoCompose.Unity.Convex.dll`
         is excluded from the ScriptAssemblies glob below (the `NeoCompose.Unity*`
         exclude), so the namespace resolves through this source shim instead —
         giving go-to-definition into the package source, not a decompiled DLL. -->
    <ProjectReference Include="..\..\src\NeoComposeConvex\NeoComposeConvex.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mirror Unity's generated csproj surface for IDE analysis: editor
         modules plus package assemblies compiled into the sample Library. -->
    <Reference Include="$(UnityManagedDir)/*.dll" Private="false" />
    <Reference Include="UnityEngine.UI" Condition="Exists('$(UnityScriptAssembliesDir)/UnityEngine.UI.dll')">
      <HintPath>$(UnityScriptAssembliesDir)/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Localization" Condition="Exists('$(UnityScriptAssembliesDir)/Unity.Localization.dll')">
      <HintPath>$(UnityScriptAssembliesDir)/Unity.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference
      Include="$(UnityScriptAssembliesDir)/*.dll"
      Exclude="$(UnityScriptAssembliesDir)/HelloWorld.dll;$(UnityScriptAssembliesDir)/Tests.dll;$(UnityScriptAssembliesDir)/NeoCompose.Unity*.dll"
      Private="false" />
  </ItemGroup>
</Project>
